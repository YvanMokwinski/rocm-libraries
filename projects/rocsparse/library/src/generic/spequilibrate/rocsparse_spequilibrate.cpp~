#include "internal/generic/rocsparse_spequilibrate.h"
#include "rocsparse_control.hpp"
#include "rocsparse_enum_utils.hpp"
#include "rocsparse_utility.hpp"
#include "rocsparse_spequilibrate_descr.hpp"
#include "rocsparse_spequilibrate_ruiz.hpp"

namespace rocsparse
{

template <>
 bool rocsparse::enum_utils::is_invalid(rocsparse_spequilibrate_stage value)
{
    switch(value)
    {
    case rocsparse_spequilibrate_stage_analysis:
    case rocsparse_spequilibrate_stage_compute:
    {
        return false;
    }
    }
    return true;
};


template <>
 bool rocsparse::enum_utils::is_invalid(rocsparse_spequilibrate_alg value)
{
    switch(value)
    {
    case rocsparse_spequilibrate_alg_default:
    case rocsparse_spequilibrate_alg_ruiz:
    {
        return false;
    }
    }
    return true;
};

template <>
 bool rocsparse::enum_utils::is_invalid(rocsparse_spequilibrate_input value)
{
    switch(value)
    {
    case rocsparse_spequilibrate_input_alg:
    case rocsparse_spequilibrate_input_ruiz_nmaxiter:
    case rocsparse_spequilibrate_input_ruiz_tol:
    {
        return false;
    }
    }
    return true;
};

template <>
 bool rocsparse::enum_utils::is_invalid(rocsparse_spequilibrate_output value)
{
    switch(value)
    {
    case rocsparse_spequilibrate_output_ruiz_iter:
    {
        return false;
    }
    case rocsparse_spequilibrate_output_ruiz_nrm:
    {
        return false;
    }
    }
    return true;
};



    
static rocsparse_status spequilibrate(rocsparse_handle            handle,
				      rocsparse_spequilibrate_descr      descr,
				      rocsparse_spequilibrate_stage      stage,
				      rocsparse_spmat_descr A,
				      rocsparse_dnvec_descr D_left,
				      rocsparse_dnvec_descr D_right,
				      size_t                      buffer_size_in_bytes,
				      void*                       buffer)
{
  ROCSPARSE_ROUTINE_TRACE;
  const rocsparse_format       format         = A->format;
  const rocsparse_spequilibrate_stage previous_stage = descr->get_stage();
  const rocsparse_spequilibrate_alg   alg            = descr->get_alg();
  
  ROCSPARSE_CHECKARG(1,
		     descr,
		     rocsparse::enum_utils::is_invalid(alg),
		     rocsparse_status_invalid_value);
  
  switch(stage)
    {
    case rocsparse_spequilibrate_stage_analysis:
      {
	switch(previous_stage)
	  {
	  case rocsparse_spequilibrate_stage_analysis:
	    {
	      RETURN_WITH_MESSAGE_IF_ROCSPARSE_ERROR(rocsparse_status_invalid_value,
						     "invalid stage, the stage rocsparse_spequilibrate_stage_analysis has already "
						     "been "
						     "executed");
	      // LCOV_EXCL_START
	    }
	    // LCOV_EXCL_STOP
	    
	  case rocsparse_spequilibrate_stage_compute:
            {
	      RETURN_WITH_MESSAGE_IF_ROCSPARSE_ERROR(
						     rocsparse_status_invalid_value,
						     "invalid stage, the stage rocsparse_spequilibrate_stage_analysis cannot be "
						     "called "
						     "after "
                    "the stage rocsparse_spequilibrate_stage_compute");
	      // LCOV_EXCL_START
            }
            }
	// LCOV_EXCL_STOP


	descr->set_stage(rocsparse_spequilibrate_stage_analysis);
	return rocsparse_status_success;
      }
      
    case rocsparse_spequilibrate_stage_compute:
      {
	
	RETURN_WITH_MESSAGE_IF_ROCSPARSE_ERROR((previous_stage == ((rocsparse_spequilibrate_stage)-1))
					       ? rocsparse_status_invalid_value
					       : rocsparse_status_success,
					       "invalid stage, the stage rocsparse_spequilibrate_stage_analysis must be executed "
					       "before "
					       "the stage rocsparse_spequilibrate_stage_compute");
	
	switch(format)
	  {
	      case rocsparse_format_csr:
		{
		  switch(descr->get_alg())
		    {
		    case rocsparse_spequilibrate_alg_default:
		    case rocsparse_spequilibrate_alg_ruiz:
		      {
			RETURN_IF_ROCSPARSE_ERROR( rocsparse::spequilibrate_ruiz(handle,
										 descr,
										 stage,
										 A,
										 D_left,
										 D_right,
										 buffer_size_in_bytes,
										 buffer) );
			break;
		      }
		    }		  
		  descr->set_stage(rocsparse_spequilibrate_stage_compute);
		  return rocsparse_status_success;
		}
		
	      case rocsparse_format_coo:
	      case rocsparse_format_csc:
	      case rocsparse_format_ell:
	      case rocsparse_format_sell:
	      case rocsparse_format_coo_aos:
	      case rocsparse_format_bsr:
	      case rocsparse_format_bell:
		{
		  // LCOV_EXCL_START
		  RETURN_IF_ROCSPARSE_ERROR(rocsparse_status_not_implemented);
		}
	  }
      }
    }
  RETURN_IF_ROCSPARSE_ERROR(rocsparse_status_invalid_value);
  // LCOV_EXCL_STOP
}


}

extern "C" rocsparse_status rocsparse_spequilibrate(rocsparse_handle            handle, // 0
						    rocsparse_spequilibrate_descr      descr, // 1
						    rocsparse_spmat_descr A, // 2
						    rocsparse_dnvec_descr D_left, // 3
						    rocsparse_dnvec_descr D_right, // 4
						    rocsparse_spequilibrate_stage      stage, // 5
						    size_t                      buffer_size_in_bytes, // 6
						    void*                       buffer, // 7
						    rocsparse_error*            p_error)
  try
    {
      ROCSPARSE_ROUTINE_TRACE;
      ROCSPARSE_CHECKARG_HANDLE(0, handle);
      ROCSPARSE_CHECKARG_POINTER(1, descr);
      ROCSPARSE_CHECKARG_POINTER(2, A);
      ROCSPARSE_CHECKARG_POINTER(3, D_left);
      ROCSPARSE_CHECKARG_POINTER(4, D_right);
      
      ROCSPARSE_CHECKARG_ENUM(5, stage);
      
      ROCSPARSE_CHECKARG(6,
			 buffer_size_in_bytes,
			 (buffer_size_in_bytes == 0) && (buffer != nullptr),
			 rocsparse_status_invalid_size);
      
      ROCSPARSE_CHECKARG(7,
			 buffer,
			 (buffer == nullptr) && (buffer_size_in_bytes != 0),
			 rocsparse_status_invalid_pointer);
      
      RETURN_IF_ROCSPARSE_ERROR(rocsparse::spequilibrate(handle,
							 descr,
							 stage,
							 A,
							 D_left,
							 D_right,
							 buffer_size_in_bytes,
							 buffer));

      return rocsparse_status_success;
      // LCOV_EXCL_START
    }
  catch(...)
    {
      RETURN_ROCSPARSE_EXCEPTION();
    }
  // LCOV_EXCL_STOP
