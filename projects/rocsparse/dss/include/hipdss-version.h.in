/*!\file
 * \brief hipdss-version.h provides the configured version and settings
 */

#ifndef HIPDSS_VERSION_H
#define HIPDSS_VERSION_H

/* clang-format off */
#define HIPDSS_VERSION_MAJOR     @hipdss_VERSION_MAJOR@
#define HIPDSS_VERSION_MINOR     @hipdss_VERSION_MINOR@
#define HIPDSS_VERSION_PATCH     @hipdss_VERSION_PATCH@
#define HIPDSS_VERSION_TWEAK     @hipdss_VERSION_TWEAK@
/* clang-format on */

#endif /* HIPDSS_VERSION_H */
